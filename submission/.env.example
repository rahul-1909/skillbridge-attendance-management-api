# Database configuration: defaults to local SQLite if unset
DATABASE_URL=sqlite:///./skillbridge.db

# JWT secret key for signing access and monitoring tokens
JWT_SECRET=super-secret-skillbridge-production-key-change-me

# Secret API key required by Monitoring Officers to authorize scoped telemetry access
MONITORING_API_KEY=monitoring-dev-key

# Automatically populate initial demo users, batches, and sessions on startup
AUTO_SEED=true
